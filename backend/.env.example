# Copy this file to .env and update values for your local MySQL setup.
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5500

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=iulat_app
DB_PASSWORD=replace_with_a_strong_local_password
DB_NAME=iulat_db

# Generate a random long value before production deployment.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
